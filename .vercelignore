# Exclude Python backend and model binaries from Vercel static build
/app/
/src/
/models/
/notebooks/
/data/
/reports/
/venv/
/env/
/.venv/
/.streamlit/
/requirements.txt
*.py
*.pyc
*.ipynb
*.joblib
*.pkl

# Explicitly ensure web/ and web/src/ are included in Vercel deployment
!/web/
!/web/**
!web/src/
!web/src/**
